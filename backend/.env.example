# Copy to backend/.env and fill in. backend/.env is ignored by Git: never commit real keys.
# The backend loads backend/.env itself at startup (real environment variables win over the file).

# Which model answers questions: anthropic (default), gemini or groq
LLM_PROVIDER=anthropic

# Only the key of the chosen provider is needed. Without it, chat answers 503 LLM_UNAVAILABLE.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional independent backup for gemini: used when every Gemini model is rate limited, down or too slow.
# Another company with its own quota. Get a key at console.groq.com, then run `python eval/groq_diagnose.py`.
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b   # best of three tested on the long cross-language set; model names change, check with groq_diagnose.py

# Optional Telegram bot (python -m bot.main). The token comes from @BotFather: never put it in code, chat or Git.
TELEGRAM_BOT_TOKEN=
# BACKEND_URL=http://127.0.0.1:8011
# TELEGRAM_ALLOWED_CHATS=   # comma separated chat ids; empty means everybody may use the bot
# BOT_MESSAGES_PER_MINUTE=10

# Optional. Leave these lines commented out to use the defaults: an empty value is not the same as unset.
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.5-flash-lite   # tested with a real key; gemini-2.5-* returned 404 for it
# GEMINI_THINKING_LEVEL=minimal
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash   # used on 429 or a slow start; "off" disables. Default: the same model with or without "-lite"
# DATA_DIR=data
# CORS_ORIGINS=http://localhost:5173
